# Semua variabel VITE_* TERLIHAT oleh browser. Jangan simpan rahasia di sini.

# URL SoundFont utama (SF2/SF3/DLS). Default: /soundfonts/GeneralUser-GS.sf3
# Harus berupa path same-origin (diawali "/") atau URL https:// dengan CORS yang mengizinkan origin aplikasi.
# VITE_SOUNDFONT_URL=/soundfonts/GeneralUser-GS.sf3

# Path model MediaPipe Hand Landmarker. Default: /models/hand_landmarker.task
# VITE_HAND_MODEL_URL=/models/hand_landmarker.task
